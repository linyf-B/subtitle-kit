# Copy to `.env` for local preview, or set the same names in
# Cloudflare Pages → Settings → Environment variables (Build), then redeploy.

# Google AdSense — Account → Account information (ca-pub-…)
# Optional slot: Ads → By ad unit → Display ads → Get code
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# Monetag — create a Banner or Native zone (NOT Popunder / OnClick)
# Paste the <script src="…"> URL from the zone snippet; zone id is optional
PUBLIC_MONETAG_ZONE=
PUBLIC_MONETAG_SCRIPT=

# PropellerAds — On-site / Native banner zone id (MagSrv). Not Push or OnClick.
PUBLIC_PROPELLER_ZONE=

# Adsterra — Banner (300x250) invocation key from Get Code
PUBLIC_ADSTERRA_KEY=

# Extra ads.txt lines, separated by |  (copy from each network dashboard)
# Example: monetag.com, 123456, DIRECT|adsterra.com, pubid, DIRECT
PUBLIC_ADS_TXT_EXTRA=
