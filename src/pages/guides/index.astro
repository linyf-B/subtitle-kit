---
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = [
  {
    href: "/guides/fix-subtitle-sync-constant-delay/",
    title: "Fix constant subtitle delay",
    blurb: "Diagnose uniform lag and apply one SRT offset.",
  },
  {
    href: "/guides/shift-srt-timing-online-free/",
    title: "Shift SRT timing online (free)",
    blurb: "Browser shift with no upload—ms or seconds.",
  },
  {
    href: "/guides/shift-vtt-timestamps-vertical-video/",
    title: "Shift VTT for vertical video",
    blurb: "WebVTT offset for Reels, Shorts, HTML5 review.",
  },
  {
    href: "/guides/srt-to-text-for-translation/",
    title: "SRT to text for translation",
    blurb: "Export dialogue for translators without timing noise.",
  },
  {
    href: "/guides/subtitle-line-length-tiktok-reels/",
    title: "Line length for TikTok & Reels",
    blurb: "Character limits for vertical captions.",
  },
  {
    href: "/guides/voice-over-read-time-calculator/",
    title: "Voice-over read time",
    blurb: "Estimate narration from word count / SRT text.",
  },
  {
    href: "/guides/delay-subtitles-500ms-dubbing/",
    title: "Delay subtitles 500ms (dubbing)",
    blurb: "Starting offset when subs are uniformly late.",
  },
  {
    href: "/guides/browser-subtitle-tools-privacy/",
    title: "Browser tools & privacy",
    blurb: "No-upload SRT/VTT processing on your device.",
  },
  {
    href: "/guides/srt-offset-milliseconds-lip-sync/",
    title: "SRT offset in milliseconds",
    blurb: "Global ms shift for lip sync and frame math.",
  },
];
---

<BaseLayout
  title="Subtitle guides — SRT workflows"
  description="Free guides: fix sync, shift SRT online, export text for translation, and check caption line length for short-form video."
  canonicalPath="/guides/"
>
  <h1>Guides</h1>
  <p class="lede">
    Step-by-step workflows for editors and translators. Each guide links to a free browser
    tool on Subtitle Kit—files stay on your device.
  </p>
  <ul class="tool-list">
    {guides.map((g) => (
      <li>
        <a href={g.href}>
          {g.title}
          <span>{g.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
