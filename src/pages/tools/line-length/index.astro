---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SeoToolExtras from "../../../components/SeoToolExtras.astro";

const faqs = [
  {
    question: "How many characters per line for TikTok or Reels?",
    answer:
      "Many editors target 32–42 Latin characters per line on 9:16 video so text does not cover faces or safe zones. Increase the limit if you use larger fonts.",
  },
  {
    question: "Does this tool edit my video?",
    answer:
      "No. It only analyzes pasted caption text and reports line lengths.",
  },
  {
    question: "How is line length counted?",
    answer:
      "Each line break starts a new line. Character count uses Unicode code points (emoji count as multiple code units in some fonts—treat results as guidance).",
  },
  {
    question: "Can I check an entire SRT file?",
    answer:
      "Paste dialogue lines or export text from our SRT to text tool, then run the checker here.",
  },
  {
    question: "Why do platforms care about line length?",
    answer:
      "Long lines wrap into tall blocks that block visuals and reduce retention on short-form feeds.",
  },
];

const steps = [
  "Paste caption or subtitle lines (one or many lines).",
  "Set your max characters per line (default 42 for vertical video).",
  "Click Check lines and fix any lines flagged over the limit.",
];
---

<BaseLayout
  title="Caption line length checker — vertical video"
  description="Check max characters per subtitle line. Compare against common 9:16 safe limits (42 chars guidance). Browser-only."
  canonicalPath="/tools/line-length/"
>
  <p class="badge">No upload to server · Runs in browser</p>
  <h1>Caption line length checker</h1>
  <p class="lede">
    Find lines that are too long for vertical short-form video before you burn in subtitles.
  </p>

  <div class="tool-panel">
    <label for="caption">Caption text (one block or multiline)</label>
    <textarea id="caption" placeholder="Line one&#10;Line two"></textarea>
    <label for="limit">Max characters per line (default 42 for vertical video)</label>
    <input type="number" id="limit" value="42" min="10" max="120" />
    <button type="button" id="run-check">Check lines</button>
    <p id="result" style="margin-top: 1rem"></p>
    <ul id="violations"></ul>
  </div>

  <div class="prose-block">
    <h2>Safe line length reference</h2>
    <p>
      For 1080×1920 captions, teams often keep <strong>32–42 characters</strong> per line in
      Latin scripts. CJK lines may use fewer glyphs because each character reads wider. Adjust
      the limit to match your font size and platform safe margins.
    </p>
  </div>

  <SeoToolExtras
    faqs={faqs}
    toolName="Caption Line Length Checker"
    toolDescription="Check subtitle line character counts for vertical and short-form video captions."
    path="/tools/line-length/"
    steps={steps}
  />
</BaseLayout>

<script>
  import { maxLineLength } from "../../../lib/srt";

  const caption = document.getElementById("caption") as HTMLTextAreaElement;
  const limitEl = document.getElementById("limit") as HTMLInputElement;
  const result = document.getElementById("result")!;
  const violations = document.getElementById("violations")!;

  document.getElementById("run-check")?.addEventListener("click", () => {
    const { max, lines } = maxLineLength(caption.value);
    const limit = parseInt(limitEl.value, 10) || 42;
    result.textContent = `Longest line: ${max} characters (${lines.length} line(s) total). Limit: ${limit}.`;
    violations.innerHTML = "";
    lines.forEach((line, i) => {
      if ([...line].length > limit) {
        const li = document.createElement("li");
        li.textContent = `Line ${i + 1}: ${[...line].length} chars — ${line.slice(0, 60)}${line.length > 60 ? "…" : ""}`;
        violations.appendChild(li);
      }
    });
    if (!violations.children.length) {
      const ok = document.createElement("li");
      ok.textContent = "All lines within limit.";
      violations.appendChild(ok);
    }
  });
</script>
