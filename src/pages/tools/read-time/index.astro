---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SeoToolExtras from "../../../components/SeoToolExtras.astro";

const faqs = [
  {
    question: "What speaking rate should I use?",
    answer:
      "Conversational English is often 140–160 words per minute. Slow narration 120–130 WPM; fast promo reads 170–180 WPM.",
  },
  {
    question: "How accurate is the estimate?",
    answer:
      "It is a planning guide only. Pauses, emphasis, and retakes change studio time—budget ±15%.",
  },
  {
    question: "Does Chinese text work?",
    answer:
      "The calculator weights CJK characters roughly as half a word each alongside space-separated words. Mixed scripts are approximate.",
  },
  {
    question: "Is my script sent to a server?",
    answer:
      "No. The estimate runs entirely in your browser.",
  },
  {
    question: "Why estimate read time for subtitles?",
    answer:
      "Voice-over and dubbing need to match slot lengths; estimating duration before recording reduces re-takes on short-form episodes.",
  },
];

const steps = [
  "Paste narration or subtitle script text.",
  "Select a words-per-minute preset matching your delivery style.",
  "Click Estimate and use the seconds/minutes result for scheduling.",
];
---

<BaseLayout
  title="Read time estimator — voice-over & narration"
  description="Estimate narration duration from script text using words-per-minute presets (130–180 WPM). Free in-browser calculator."
  canonicalPath="/tools/read-time/"
>
  <p class="badge">No upload to server · Runs in browser</p>
  <h1>Read time estimator</h1>
  <p class="lede">
    Plan voice-over length before you record—pick a speaking rate and get approximate duration
    in seconds or minutes.
  </p>

  <div class="tool-panel">
    <label for="script">Script text</label>
    <textarea id="script"></textarea>
    <label for="wpm">Words per minute</label>
    <select id="wpm">
      <option value="130">130 — slow / dramatic</option>
      <option value="150" selected>150 — conversational</option>
      <option value="170">170 — fast promo</option>
      <option value="180">180 — rapid fire</option>
    </select>
    <button type="button" id="run-estimate">Estimate</button>
    <p id="estimate-result" style="font-size: 1.25rem; font-weight: 600"></p>
  </div>

  <SeoToolExtras
    faqs={faqs}
    toolName="Read Time Estimator"
    toolDescription="Estimate voice-over duration from script text using adjustable words per minute."
    path="/tools/read-time/"
    steps={steps}
  />
</BaseLayout>

<script>
  import { estimateDurationSeconds } from "../../../lib/srt";

  const script = document.getElementById("script") as HTMLTextAreaElement;
  const wpm = document.getElementById("wpm") as HTMLSelectElement;
  const out = document.getElementById("estimate-result")!;

  document.getElementById("run-estimate")?.addEventListener("click", () => {
    const sec = estimateDurationSeconds(script.value, parseInt(wpm.value, 10));
    const m = Math.floor(sec / 60);
    const s = Math.round(sec % 60);
    out.textContent =
      sec < 60
        ? `About ${Math.round(sec)} seconds`
        : `About ${m} min ${s} sec (${Math.round(sec)} s total)`;
  });
</script>
